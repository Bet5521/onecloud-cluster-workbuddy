# OneCloud Cluster - .gitignore

# 敏感配置
.env
.env.local
*.env.local

# 本地环境覆盖 (IP/主机名自定义, 不入库; 模板见 nodes.local.yaml.example)
inventory/nodes.local.yaml

# 工作区元数据
.workbuddy/

# WireGuard 密钥库与生成产物 (由 scripts/wireguard-setup.sh 生成, 含私钥)
# 整目录忽略, 已覆盖下面三条细粒度规则 (保留注释以说明忽略范围)
wireguard/
node-*/wireguard/wg0.conf

# Cloudflare 凭据
cloudflared/credentials.json
cloudflared/tunnel-token

# 备份数据
backups/
*.tar.gz
*.bak

# 运行时数据
node-*/homeassistant/.storage/
node-*/homeassistant/home-assistant.db
node-*/syncthing/index-v0.14.db
node-*/syncthing/key.pem
node-*/aria2/aria2.session
node-*/cupsd/ppd/
node-*/adguard/AdGuardHome.yaml
node-*/memos/memos_prod.db
node-*/piwigo/config/database.inc.php

# Native 二进制
node-*/native/bin/
node-*/native/*.deb
node-*/native/*.tar.gz
node-*/native/*.gz

# Python
panel/__pycache__/
panel/*.pyc
panel/.venv/
panel/venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker volumes
docker-compose.override.yml

# 验证脚本输出
test_report.txt
test_run.txt
*.log
# 开发用的小工具 (只跑单个测试组, 本地保留不入库)
_run_one.py

# Python 缓存
__pycache__/
*.pyc
